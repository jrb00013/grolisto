# Server
PORT=3847
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3847

# OpenRouter (https://openrouter.ai)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional site attribution for OpenRouter rankings
OPENROUTER_SITE_URL=https://github.com/jrb00013/grolisto
OPENROUTER_SITE_NAME=grolisto

# OpenRouter model tier routing
ROUTE_SIMPLE_MODEL=openai/gpt-4o-mini
ROUTE_STANDARD_MODEL=anthropic/claude-3.5-sonnet
ROUTE_COMPLEX_MODEL=anthropic/claude-sonnet-4
ROUTE_FALLBACK_MODEL=openrouter/auto
ROUTE_COMPLEXITY_SIMPLE_MAX=0.35
ROUTE_COMPLEXITY_STANDARD_MAX=0.7

# Scotr — store pricing (Kroger free developer + Open Prices fallback)
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
KROGER_API_BASE=https://api-ce.kroger.com/v1
SCOTR_USE_MOCK=true
SCOTR_CACHE_TTL_MS=300000
SCOTR_DEFAULT_ZIP=10001

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_RECIPES=grolisto_recipes
QDRANT_COLLECTION_INGREDIENTS=grolisto_ingredients
QDRANT_COLLECTION_PREFS=grolisto_prefs
QDRANT_COLLECTION_PLANS=grolisto_plans
EMBEDDING_MODEL=openai/text-embedding-3-small
RERANK_MODEL=openai/gpt-4o-mini

# Preference learning
PREFS_PATH=./data/prefs
NOVELTY_DECAY=0.85
NOVELTY_FLOOR=0.25

# Auth (required for signup/login — generate a long random string)
AUTH_JWT_SECRET=
AUTH_JWT_TTL=7d
AUTH_USERS_PATH=./data/users

# Daily calorie / nutrition goal defaults (overridden per profile)
DEFAULT_CALORIE_GOAL=2000
DEFAULT_WEEKLY_BUDGET=80

# USDA FoodData Central (free data.gov key) — optional; seed fallback used if empty
FDC_API_KEY=
FDC_BASE_URL=https://api.nal.usda.gov/fdc/v1
FDC_CACHE_TTL_MS=86400000

# Chat sessions + context packing
CHAT_SESSIONS_PATH=./data/chat-sessions
CHAT_CONTEXT_TOKEN_BUDGET=6000
CHAT_RECENT_TURNS=12
CHAT_SUMMARY_TRIGGER_TURNS=16
CHAT_MAX_MESSAGE_CHARS=4000
